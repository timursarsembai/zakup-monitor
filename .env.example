POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://zakup:change-me@127.0.0.1:5437/zakup
# Only for tests; the suite wipes this database.
TEST_DATABASE_URL=postgresql://zakup:change-me@127.0.0.1:5437/zakup_test
# Токен доступа к ows.goszakup.gov.kz (выдаётся в личном кабинете портала).
GOSZAKUP_TOKEN=
# Seconds between API requests.
GOSZAKUP_REQUEST_DELAY=0.5
# Вход в веб-интерфейс (HTTP Basic). Имя пользователя — это e-mail владельца.
ZAKUP_WEB_USER=
ZAKUP_WEB_PASSWORD=
# Telegram: бот для уведомлений; chat id — для служебных сообщений владельцу.
ZAKUP_TELEGRAM_BOT_TOKEN=
ZAKUP_TELEGRAM_CHAT_ID=
